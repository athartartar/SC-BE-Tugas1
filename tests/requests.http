@baseUrl = http://localhost:3000

### 1. Health Check
GET {{baseUrl}}/health HTTP/1.1

### 2. Get All Books
GET {{baseUrl}}/books HTTP/1.1

### 3. Create Book
# @name createBook
POST {{baseUrl}}/books HTTP/1.1
Content-Type: application/json

{
  "title": "Clean Code",
  "author": "Robert C. Martin",
  "year": 2008,
  "stock": 5
}

### 4. Get Book by ID
@bookId = {{createBook.response.body.id}}
GET {{baseUrl}}/books/{{bookId}} HTTP/1.1

### 5. Update Book
PUT {{baseUrl}}/books/{{bookId}} HTTP/1.1
Content-Type: application/json

{
  "title": "Clean Code (Updated Edition)",
  "author": "Robert C. Martin",
  "year": 2009,
  "stock": 8
}

### 6. Delete Book
DELETE {{baseUrl}}/books/{{bookId}} HTTP/1.1

### 7. Get Deleted Book (Expect 404)
GET {{baseUrl}}/books/{{bookId}} HTTP/1.1
